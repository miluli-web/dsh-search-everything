{
  "name": "dsh-search-everything",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin: one ctx.web search provider that routes across AnySearch, Firecrawl, TinyFish and DeepSeek.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "anysearch",
    "firecrawl",
    "search"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miluli-web/dsh-search-everything.git"
  },
  "homepage": "https://github.com/miluli-web/dsh-search-everything#readme",
  "bugs": {
    "url": "https://github.com/miluli-web/dsh-search-everything/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
